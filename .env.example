HOST=127.0.0.1
PORT=3000
# local | public. Set public behind ANY reverse proxy, even if HOST is localhost.
APP_MODE=local
# Optional exact external origin for same-origin checks behind a proxy.
PUBLIC_ORIGIN=
# OpenAI-compatible base; localhost HTTP is allowed for local models.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Required for public AI, at least 16 characters. Never commit real credentials.
APP_TOKEN=
# Request budget per UTC day, per server process. Includes failed provider calls.
LLM_DAILY_LIMIT=200
