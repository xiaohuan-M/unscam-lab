{
  "name": "unscam-lab",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write public/*.js public/lib/*.js public/*.css public/*.html server/*.mjs scripts/*.mjs tests/*.mjs tests/e2e/*.js",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2"
  }
}
